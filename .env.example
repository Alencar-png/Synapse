# ============================================================
# Synapse — variáveis de ambiente (todas opcionais)
# ============================================================
# Copie para `.env` e ajuste. O `.env` está no `.gitignore`.
#
# Nada aqui é obrigatório: o app desktop define o que precisa na hora de
# chamar a transcrição, e o resto tem padrão no config.yaml. Estas variáveis
# servem para sobrescrever a configuração sem editar arquivo.

# ----- Whisper -----
# MEETING_WHISPER_BACKEND=auto      # auto | cpp | openai
# MEETING_WHISPER_MODEL=large-v3-turbo
# MEETING_WHISPER_LANGUAGE=pt
# MEETING_WHISPER_DEVICE=auto       # auto | cuda | cpu
# Caminhos do whisper.cpp (vazio => detecta em .whisper-cpp/ e .models/)
# MEETING_WHISPER_CLI_PATH=
# MEETING_WHISPER_MODEL_PATH=
# 0 => todos os núcleos da CPU
# MEETING_WHISPER_THREADS=0
# Detecção de voz (evita alucinação no silêncio); precisa do ggml-silero-*.bin
# MEETING_WHISPER_VAD=true
# MEETING_WHISPER_VAD_MODEL_PATH=
# MEETING_WHISPER_SUPPRESS_NST=true

# ----- Logging -----
# MEETING_LOG_LEVEL=INFO

# === AIOX Variables (added 2026-09-14) ===
# Cost: ~$0.14/M tokens with tool calling support
DEEPSEEK_API_KEY=
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API Key - Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Get your key at: https://exa.ai/
EXA_API_KEY=
# Usually free, no key required for basic usage
CONTEXT7_API_KEY=
# Get from your Supabase project settings
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=
# Get from: ClickUp Settings > Apps > API Token
CLICKUP_API_KEY=
# From your N8N instance settings
N8N_API_KEY=
N8N_WEBHOOK_URL=
# Sentry (error tracking)
SENTRY_DSN=
# Railway (deployment)
RAILWAY_TOKEN=
# Vercel (deployment)
VERCEL_TOKEN=
# --------------------------------------------
NODE_ENV=development
AIOX_VERSION=5.4.1
